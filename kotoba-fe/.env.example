# Copy to .env.local. All variables are optional.

# kotoba-be base URL used by the server (default http://127.0.0.1:4000).
# API_URL=http://127.0.0.1:4000

# Dev server only: extra hostnames allowed to load the dev bundle, comma-separated, without scheme or port.
# Needed when the app is opened from another device, e.g. this machine's LAN or public address.
# ALLOWED_DEV_ORIGINS=192.168.1.20,dev.example.com
